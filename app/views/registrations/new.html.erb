<% page_title t("auth.sign_up") %>

<div class="ec-auth">
  <%= render "shared/auth_brand" %>

  <main class="ec-auth-form-wrap">
    <div class="ec-auth-card">
      <div class="ec-auth-logo ec-auth-logo-mobile">
        <i class="bi bi-piggy-bank-fill"></i>
        <span><%= t("app.name") %></span>
      </div>

      <header class="ec-auth-header">
        <h2><%= t("auth.sign_up") %></h2>
        <p><%= t("auth.sign_up_subtitle") %></p>
      </header>

      <%= render "shared/auth_flash" %>

      <% if @user.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <ul class="mb-0 ps-3">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: registration_path, class: "ec-auth-fields" do |form| %>
        <div class="form-floating ec-auth-field">
          <%= form.text_field :name, autofocus: true, autocomplete: "name", placeholder: " ",
                class: "form-control form-control-lg", id: "registration_name" %>
          <%= form.label :name, "Nome", for: "registration_name" %>
          <i class="bi bi-person ec-auth-field-icon"></i>
        </div>

        <div class="form-floating ec-auth-field">
          <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: " ",
                class: "form-control form-control-lg", id: "registration_email_address" %>
          <%= form.label :email_address, "E-mail", for: "registration_email_address" %>
          <i class="bi bi-envelope ec-auth-field-icon"></i>
        </div>

        <%= render "shared/password_field", form: form, field: :password, label: "Senha",
              id: "registration_password", autocomplete: "new-password" %>
        <%= render "shared/password_field", form: form, field: :password_confirmation, label: "Confirmar senha",
              id: "registration_password_confirmation", autocomplete: "new-password", icon: "bi-shield-lock" %>

        <div class="form-floating ec-auth-field">
          <%= form.telephone_field :phone, value: @user.formatted_phone, required: true, autocomplete: "tel-national",
                placeholder: " ", class: "form-control form-control-lg", id: "registration_phone",
                data: { controller: "phone-mask" } %>
          <%= form.label :phone, "Celular", for: "registration_phone" %>
          <i class="bi bi-phone ec-auth-field-icon"></i>
        </div>

        <div class="ec-auth-actions">
          <%= form.submit t("auth.sign_up"), class: "btn btn-primary btn-lg w-100 ec-auth-submit" %>
        </div>

        <div class="ec-auth-foot">
          <span class="text-muted small">
            <%= t("auth.have_account") %>
            <%= link_to t("auth.sign_in"), new_session_path, class: "ec-auth-link" %>
          </span>
        </div>
      <% end %>

      <%= render "shared/google_button" %>
    </div>
  </main>
</div>
