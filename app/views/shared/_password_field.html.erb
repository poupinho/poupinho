<%# locals: (form:, field:, label:, id:, autocomplete: "current-password", autofocus: false, icon: "bi-lock") %>
<div class="form-floating ec-auth-field" data-controller="password-toggle">
  <%= form.password_field field,
        required: true,
        autofocus: autofocus,
        autocomplete: autocomplete,
        maxlength: 72,
        placeholder: " ",
        class: "form-control form-control-lg",
        id: id,
        data: { password_toggle_target: "input" } %>
  <%= form.label field, label, for: id %>
  <i class="bi <%= icon %> ec-auth-field-icon"></i>
  <button type="button" class="ec-auth-field-toggle"
          data-action="click->password-toggle#toggle"
          aria-label="Mostrar ou ocultar senha">
    <i class="bi bi-eye" data-password-toggle-target="eye"></i>
    <i class="bi bi-eye-slash d-none" data-password-toggle-target="eyeSlash"></i>
  </button>
</div>
