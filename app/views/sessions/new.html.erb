<% page_title t("auth.sign_in") %>

<div class="ec-auth">
  <%= render "shared/auth_brand" %>

  <main class="ec-auth-form-wrap">
    <div class="ec-auth-card">
      <div class="ec-auth-logo ec-auth-logo-mobile">
        <i class="bi bi-piggy-bank-fill"></i>
        <span><%= t("app.name") %></span>
      </div>

      <header class="ec-auth-header">
        <h2><%= t("auth.sign_in") %></h2>
        <p><%= t("auth.sign_in_subtitle") %></p>
      </header>

      <%= render "shared/auth_flash" %>

      <%= form_with url: session_path, class: "ec-auth-fields" do |form| %>
        <div class="form-floating ec-auth-field">
          <%= form.email_field :email_address,
                required: true, autofocus: true, autocomplete: "username",
                placeholder: " ", value: params[:email_address],
                class: "form-control form-control-lg", id: "session_email_address" %>
          <%= form.label :email_address, "E-mail", for: "session_email_address" %>
          <i class="bi bi-envelope ec-auth-field-icon"></i>
        </div>

        <%= render "shared/password_field", form: form, field: :password, label: "Senha", id: "session_password" %>

        <div class="ec-auth-actions">
          <%= form.submit t("auth.sign_in"), class: "btn btn-primary btn-lg w-100 ec-auth-submit" %>
        </div>

        <div class="ec-auth-foot d-flex flex-column align-items-center gap-2">
          <%= link_to new_password_path, class: "ec-auth-link" do %>
            <i class="bi bi-key"></i><span><%= t("auth.forgot_password") %></span>
          <% end %>
          <span class="text-muted small">
            <%= t("auth.no_account") %>
            <%= link_to t("auth.sign_up"), new_registration_path, class: "ec-auth-link" %>
          </span>
        </div>
      <% end %>

      <%= render "shared/google_button" %>
    </div>
  </main>
</div>
