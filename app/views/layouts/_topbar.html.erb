<header class="ec-topbar">
  <div class="ec-topbar-inner">
    <%= link_to dashboard_path, class: "ec-brand" do %>
      <span class="ec-brand-mark"><i class="bi bi-piggy-bank-fill"></i></span>
      <span class="ec-brand-name"><%= t("app.name") %></span>
    <% end %>

    <nav class="ec-topnav" aria-label="<%= t('nav.main') %>">
      <% main_nav_items.each do |item| %>
        <%= nav_link(item) %>
      <% end %>
      <%= nav_link(categories_nav_item) %>
    </nav>

    <div class="ec-topbar-actions">
      <%= link_to new_saving_path, class: "btn btn-primary btn-sm ec-topbar-add" do %>
        <i class="bi bi-plus-lg"></i> <span><%= t("savings.index.new") %></span>
      <% end %>

      <button type="button"
              class="ec-icon-btn"
              data-action="click->theme#toggle"
              data-theme-target="toggle"
              title="Alternar tema claro/escuro"
              aria-label="Alternar tema">
        <i class="bi bi-sun-fill" data-theme-target="lightIcon"></i>
        <i class="bi bi-moon-stars-fill d-none" data-theme-target="darkIcon"></i>
      </button>

      <div class="dropdown ec-user-menu">
        <button class="ec-icon-btn dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="<%= t('nav.account') %>">
          <%= user_avatar(current_user) %>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li>
            <span class="dropdown-item-text">
              <span class="ec-user-name"><%= current_user.display_name %></span>
              <span class="ec-user-email"><%= current_user.email_address %></span>
            </span>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li><%= link_to edit_profile_path, class: "dropdown-item" do %>
            <i class="bi bi-person-gear me-1"></i> <%= t("nav.profile") %>
          <% end %></li>
          <li><%= link_to tips_path, class: "dropdown-item" do %>
            <i class="bi bi-lightbulb me-1"></i> <%= t("nav.tips") %>
          <% end %></li>
          <li><%= link_to categories_path, class: "dropdown-item d-md-none" do %>
            <i class="bi bi-tags me-1"></i> <%= t("nav.categories") %>
          <% end %></li>
          <li><%= link_to root_path, class: "dropdown-item" do %>
            <i class="bi bi-window me-1"></i> <%= t("nav.landing") %>
          <% end %></li>
          <% if current_user.admin? %>
            <li><hr class="dropdown-divider"></li>
            <li><%= link_to admin_root_path, class: "dropdown-item" do %>
              <i class="bi bi-speedometer me-1"></i> <%= t("nav.admin") %>
            <% end %></li>
          <% end %>
          <li><%= button_to session_path, method: :delete, class: "dropdown-item", form: { style: "margin:0" } do %>
            <i class="bi bi-box-arrow-right me-1"></i> <%= t("nav.sign_out") %>
          <% end %></li>
        </ul>
      </div>
    </div>
  </div>
</header>
