<% page_title @user.display_name %>

<div class="ec-page-head">
  <%= link_to admin_users_path, class: "ec-back", aria: { label: t("savings.show.back") } do %>
    <i class="bi bi-arrow-left"></i>
  <% end %>
  <div>
    <h1><%= @user.display_name %><% if @user.admin? %> <span class="badge text-bg-secondary align-middle">admin</span><% end %></h1>
    <span class="ec-page-sub"><%= @user.email_address %> · <%= @user.formatted_phone || t("admin.users.no_phone") %> · <%= t("admin.users.since", date: l(@user.created_at.to_date)) %></span>
  </div>
</div>

<div class="ec-tiles ec-tiles-4">
  <div class="ec-tile ec-kpi-card" style="--tile-color: #0ba360">
    <span class="ec-tile-icon"><i class="bi bi-piggy-bank-fill"></i></span>
    <span class="ec-tile-body">
      <span class="ec-tile-label"><%= t("dashboards.hero.total") %></span>
      <span class="ec-tile-value"><%= format_brl(@summary.all_time_total) %></span>
      <span class="ec-tile-hint"><%= t("admin.dashboard.kpi.savings_count", count: @user.savings.count) %></span>
    </span>
  </div>
  <div class="ec-tile ec-kpi-card" style="--tile-color: #f59e0b">
    <span class="ec-tile-icon"><i class="bi bi-calendar3"></i></span>
    <span class="ec-tile-body">
      <span class="ec-tile-label"><%= t("dashboards.kpi.month") %></span>
      <span class="ec-tile-value"><%= format_brl(@summary.month_total) %></span>
      <span class="ec-tile-hint"><%= t("dashboards.kpi.year") %>: <%= format_brl(@summary.year_total) %></span>
    </span>
  </div>
  <div class="ec-tile ec-kpi-card" style="--tile-color: #8b5cf6">
    <span class="ec-tile-icon"><i class="bi bi-fire"></i></span>
    <span class="ec-tile-body">
      <span class="ec-tile-label"><%= t("dashboards.streak.title") %></span>
      <span class="ec-tile-value"><%= t("dashboards.streak.days", count: @summary.current_streak) %></span>
      <span class="ec-tile-hint"><%= t("dashboards.streak.best", count: @score.best_streak) %></span>
    </span>
  </div>
  <div class="ec-tile ec-kpi-card" style="--tile-color: #3b82f6">
    <span class="ec-tile-icon"><i class="bi bi-stars"></i></span>
    <span class="ec-tile-body">
      <span class="ec-tile-label"><%= t("gamification.level_label", level: @score.level) %></span>
      <span class="ec-tile-value"><%= @score.level_name %></span>
      <span class="ec-tile-hint"><%= t("gamification.points", count: @score.points) %></span>
    </span>
  </div>
</div>

<div class="row g-3 mt-1">
  <div class="col-12 col-xl-5">
    <div class="card h-100"><div class="card-body">
      <h2 class="ec-section-title"><%= t("nav.goals") %></h2>
      <% if @goals.any? %>
        <ul class="ec-level-list">
          <% @goals.each do |row| %>
            <li>
              <span><i class="bi <%= row.goal.icon %>" style="color: <%= row.goal.color %>"></i> <%= row.goal.name %><% if row.achieved? %> <i class="bi bi-trophy-fill text-warning"></i><% end %></span>
              <strong><%= format_brl(row.saved) %> / <%= format_brl(row.goal.target_amount, precision: 0) %> (<%= row.progress %>%)</strong>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted mb-0"><%= t("admin.users.no_goals") %></p>
      <% end %>
    </div></div>
  </div>
  <div class="col-12 col-xl-7">
    <div class="card h-100"><div class="card-body">
      <h2 class="ec-section-title"><%= t("admin.users.recent") %></h2>
      <% if @recent.any? %>
        <ul class="ec-list ec-admin-list">
          <% @recent.each do |saving| %>
            <li><span class="ec-list-item">
              <%= category_icon(saving.category) %>
              <span class="ec-list-body">
                <span class="ec-list-title"><%= saving.title %></span>
                <span class="ec-list-meta"><%= l(saving.saved_on) %><%= " · #{saving.category.name}" if saving.category %><%= " · #{saving.goal.name}" if saving.goal %></span>
              </span>
              <span class="ec-amount"><%= format_brl(saving.amount) %></span>
            </span></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted mb-0"><%= t("admin.users.no_savings") %></p>
      <% end %>
    </div></div>
  </div>
</div>
