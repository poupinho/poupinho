# Segredos do Kamal — referenciados em config/deploy.yml.
# Este arquivo é commitado, mas NÃO contém valores raw — apenas referências.

# POSTGRES_PASSWORD vem do .env (gitignored).
POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env 2>/dev/null | head -1 | cut -d= -f2-)
ECONOMIZA_DATABASE_PASSWORD=$POSTGRES_PASSWORD

# GITHUB_TOKEN é exportado no shell e propagado para o container Kamal via Makefile.
KAMAL_REGISTRY_PASSWORD=$GITHUB_TOKEN

# Master key do Rails — lido direto do arquivo do projeto.
RAILS_MASTER_KEY=$(cat config/master.key)

# Web Push (VAPID) — do .env.
VAPID_PUBLIC_KEY=$(grep '^VAPID_PUBLIC_KEY=' .env 2>/dev/null | head -1 | cut -d= -f2-)
VAPID_PRIVATE_KEY=$(grep '^VAPID_PRIVATE_KEY=' .env 2>/dev/null | head -1 | cut -d= -f2-)

# Login com Google (OAuth) — do .env.
GOOGLE_CLIENT_ID=$(grep '^GOOGLE_CLIENT_ID=' .env 2>/dev/null | head -1 | cut -d= -f2-)
GOOGLE_CLIENT_SECRET=$(grep '^GOOGLE_CLIENT_SECRET=' .env 2>/dev/null | head -1 | cut -d= -f2-)

# Analytics (Google Analytics 4) — do .env. Vazio desliga.
GA_MEASUREMENT_ID=$(grep '^GA_MEASUREMENT_ID=' .env 2>/dev/null | head -1 | cut -d= -f2-)
