# Copie este arquivo para `.env` (gitignored) e preencha os valores reais.
# Lido automaticamente por .kamal/secrets antes de cada `kamal deploy`.

# GITHUB_TOKEN já vem do shell (export no .zshrc/.bashrc) — não precisa redefinir aqui.
# Precisa ter escopo `write:packages` para fazer push no GHCR.

# IP (ou hostname) do servidor de produção, usado pelo Kamal e por `make ssh`.
DEPLOY_HOST=203.0.113.10

# Senha do Postgres de produção. Gere uma forte, ex.:
#   openssl rand -base64 32
# Depois de criado, NÃO mudar sem coordenar com o volume existente.
POSTGRES_PASSWORD=cole_uma_senha_forte_aqui

# Login com Google (OAuth 2). Cliente "Web application" no Google Cloud Console (projeto poupinho):
#   origens: http://localhost:3002 e https://poupinho.com.br
#   redirecionamentos: http://localhost:3002/auth/google_oauth2/callback e https://poupinho.com.br/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Analytics (Google Analytics 4). ID de medição da propriedade, ex.: G-XXXXXXXXXX.
# Vazio = analytics desligado (deixe vazio em desenvolvimento).
GA_MEASUREMENT_ID=
